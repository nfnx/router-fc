{
  "info": {
    "name": "Router Alibaba FC - routing acceptance",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "One business API, GPU retrieval and one review call. Error cases intentionally expect 4xx. Use independent Router token."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{fc_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://rethos-router-rpboglliga.cn-hangzhou.fcapp.run"
    },
    {
      "key": "fc_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Service version",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Router identity', () => pm.expect(pm.response.json().service).eq('rethos-router-fc'));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Live",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health/live",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Alive', () => pm.expect(pm.response.json().status).eq('alive'));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Ready",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health/ready",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Ready', () => pm.expect(pm.response.json().status).eq('ready'));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 OpenAPI",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/openapi.json",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Business operation', () => pm.expect(pm.response.json().paths['/route']).to.have.property('post'));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Corpus retrieval",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/route",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"request\": \"Search only the uploaded fixed paper corpus and provide cited evidence on CRISPR off-target measurement.\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Exactly three fields', () => pm.expect(Object.keys(pm.response.json()).sort()).deep.eq(['harness','model','skills']));",
              "pm.test('Valid route', () => {const b=pm.response.json();pm.expect(['codex','claude','dsh']).include(b.harness);pm.expect(['deepseek','glm']).include(b.model);pm.expect(b.skills).to.be.an('array');pm.expect(b.skills.length).at.most(1);});"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Deep research",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/route",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"request\": \"Research current evidence on sodium-ion battery degradation and synthesize sources.\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
