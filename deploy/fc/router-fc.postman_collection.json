              "pm.test('Valid route', () => {const b=pm.response.json();pm.expect(['codex','claude','dsh']).include(b.harness);pm.expect(['deepseek','glm']).include(b.model);pm.expect(b.skills).to.be.an('array');pm.expect(b.skills.length).at.most(1);});",
              "pm.test('Provider preserved', () => pm.expect(pm.response.json().model).eq('glm'));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 DeepSeek speed constraint",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/route",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"request\": \"Use DeepSeek only. Prioritize low latency. Investigate evidence on battery recycling.\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Exactly three fields', () => pm.expect(Object.keys(pm.response.json()).sort()).deep.eq(['harness','model','skills']));",
              "pm.test('Valid route', () => {const b=pm.response.json();pm.expect(['codex','claude','dsh']).include(b.harness);pm.expect(['deepseek','glm']).include(b.model);pm.expect(b.skills).to.be.an('array');pm.expect(b.skills.length).at.most(1);});",
              "pm.test('Provider preserved', () => pm.expect(pm.response.json().model).eq('deepseek'));"
            ]
          }
