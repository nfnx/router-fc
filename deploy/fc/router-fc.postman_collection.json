              "pm.test('Valid route', () => {const b=pm.response.json();pm.expect(['codex','claude','dsh']).include(b.harness);pm.expect(['deepseek','glm']).include(b.model);pm.expect(b.skills).to.be.an('array');pm.expect(b.skills.length).at.most(1);});"
            ]
          }
        }
      ]
    },
